# Telegram Bot API — заявки с сайта
# 1) Создайте бота у @BotFather и вставьте токен
TELEGRAM_BOT_TOKEN=
# 2) ID чата/группы, куда слать заявки (узнать: @userinfobot или getUpdates)
TELEGRAM_CHAT_ID=

# Админ-панель /admin
ADMIN_PASSWORD=change-me-strong-password
# Случайная строка 32+ символа для подписи сессии
ADMIN_SECRET=replace-with-long-random-string
